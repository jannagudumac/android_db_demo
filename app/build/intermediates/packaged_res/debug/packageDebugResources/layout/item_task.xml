<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="64dp" android:gravity="center_vertical"
    android:orientation="horizontal">
    <CheckBox android:id="@+id/taskCompleted"
        android:layout_width="48dp" android:layout_height="48dp" />
    <TextView android:id="@+id/taskTitle"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="17sp"
        android:paddingTop="12dp" android:paddingBottom="12dp" />
    <ImageButton android:id="@+id/editTask"
        android:layout_width="48dp" android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_edit" android:contentDescription="@string/edit_task" />
    <ImageButton android:id="@+id/deleteTask"
        android:layout_width="48dp" android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_delete" android:contentDescription="@string/delete" />
</LinearLayout>
