<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="30sp"
        android:textColor="#20382F" android:textStyle="bold"
        android:layout_marginBottom="16dp" />
    <EditText
        android:id="@+id/taskInput"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp" android:hint="@string/new_task"
        android:importantForAutofill="no" android:inputType="textCapSentences" android:maxLines="1" />
    <Button
        android:id="@+id/addButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/add" />
    <Button
        android:id="@+id/exportButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/export_tasks" android:enabled="false" />
    <TextView
        android:id="@+id/counter"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="16dp" android:paddingBottom="12dp"
        android:text="@string/loading" android:textSize="16sp"
        android:accessibilityLiveRegion="polite" />
    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/empty_state" android:paddingTop="24dp"
        android:gravity="center" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/taskList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
